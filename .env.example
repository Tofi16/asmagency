# Copy this file to .env and fill in real values before running the app.

FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-long-random-string

# Local dev defaults to SQLite (no setup needed). For Postgres use:
# DATABASE_URL=postgresql://asm_user:asm_password@localhost:5432/asm_agency
DATABASE_URL=

UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=5242880

SESSION_COOKIE_SECURE=False
RATELIMIT_STORAGE_URI=memory://
CACHE_TYPE=SimpleCache
